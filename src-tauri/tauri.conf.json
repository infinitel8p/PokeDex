{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokeDex",
  "version": "0.2.0",
  "identifier": "com.InfiniteL8p.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PokeDex",
        "width": 500,
        "height": 900,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "transparent": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 500,
        "height": 900,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/*"
    ]
  }
}
